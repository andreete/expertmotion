{
  "name": "@expertmotion/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run ../../apps/desktop",
    "build:main": "node scripts/build-main.mjs",
    "harden": "node scripts/harden.mjs",
    "harden:plan": "node scripts/harden.mjs --plan",
    "pack:win": "electron-builder --win nsis --x64 --config electron-builder.config.cjs --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "@expertmotion/shared": "0.0.0",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "@remotion/renderer": "4.0.535",
    "systeminformation": "5.33.16",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.12",
    "javascript-obfuscator": "5.9.0",
    "bytenode": "2.0.0"
  }
}
