{
  "name": "@expertmotion/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./formats": {
      "source": "./src/formats.ts",
      "types": "./dist/formats.d.ts",
      "default": "./dist/formats.js"
    },
    "./metadata": {
      "source": "./src/metadata.ts",
      "types": "./dist/metadata.d.ts",
      "default": "./dist/metadata.js"
    }
  },
  "dependencies": {
    "@expertmotion/catalogue": "0.0.0",
    "@expertmotion/composition-model": "0.0.0",
    "@expertmotion/shared": "0.0.0",
    "@remotion/effects": "4.0.535",
    "@remotion/fonts": "4.0.535",
    "@remotion/layout-utils": "4.0.535",
    "@remotion/media": "4.0.535",
    "@remotion/noise": "4.0.535",
    "@remotion/paths": "4.0.535",
    "@remotion/rough-notation": "4.0.535",
    "@remotion/shapes": "4.0.535",
    "@remotion/transitions": "4.0.535",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "@types/react": "19.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/archivo": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0"
  },
  "scripts": {
    "fonts": "node scripts/copy-fonts.mjs",
    "build:bundle": "node scripts/build-bundle.mjs"
  }
}
