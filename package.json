{
  "name": "expertmotion",
  "private": true,
  "version": "0.0.0",
  "description": "Expertmotion monorepo (see README.md and docs/INDEX.md)",
  "type": "module",
  "engines": { "node": ">=22.13 <23" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "typecheck": "tsc -b packages/shared packages/catalogue packages/composition-model packages/agents",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "bash scripts/verify.sh",
    "docs:check": "bash tools/docs-check.sh"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
